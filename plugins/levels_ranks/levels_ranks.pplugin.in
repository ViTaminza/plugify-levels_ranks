		{
			"name": "OnExpChangedPre_Register",
			"funcName": "OnExpChangedPre_Register",
			"group": "callbacks",
			"description": "Registers the listener that fires before experience is added to a player (every NotifClient call, i.e. kills, assists, rounds, bombs, hostages, the admin give/take menu and the module's own ChangeClientValue path). giveExp is by reference and a module may replace it; a value changed to 0 makes the core skip the change, exactly like the original.",
			"paramTypes": [
				{
					"name": "callback",
					"type": "function",
					"ref": false,
					"prototype": {
						"name": "ExpChangedPreCallback",
						"funcName": "ExpChangedPreCallback",
						"description": "Called before experience is applied; may rewrite giveExp.",
						"paramTypes": [
							{
								"name": "slot",
								"type": "int32",
								"ref": false,
								"description": "Player slot, 0..63."
							},
							{
								"name": "giveExp",
								"type": "int32",
								"ref": true,
								"description": "Experience about to be added; may be changed in place."
							}
						],
						"retType": {
							"type": "void"
						}
					},
					"description": "Function to invoke."
				}
			],
			"retType": {
				"type": "void"
			}
		},
